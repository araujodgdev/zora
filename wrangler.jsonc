{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zora",
  // The personal Cloudflare account; deploys and `--remote` commands use it.
  "account_id": "bf552f67bcf46921dbe4137ee0ff8980",
  // Must not be later than the installed workerd supports.
  "compatibility_date": "2026-11-13",
  // Better Auth needs Node.js APIs.
  // Default since 2026-08-04, kept explicit for clarity.
  "compatibility_flags": ["nodejs_compat"],
  // Start's handler plus the exported Durable Object classes (StudioEngine).
  "main": "src/server.ts",
  // Served only at https://zora.lume.software (zone lume.software, same
  // account). Wrangler creates the DNS record and certificate on deploy.
  // BETTER_AUTH_URL must match this origin.
  "routes": [{ "pattern": "zora.lume.software", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zora",
      // Production database (region ENAM). Local dev and tests use a
      // simulated copy under .wrangler/state.
      "database_id": "31990be2-fe73-4feb-bbda-c6dd16e76b09",
      // drizzle-kit writes each migration as drizzle/<name>/migration.sql.
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
    }
  ],
  // Uploaded media (bucket created with `wrangler r2 bucket create`).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zora-media" }],
  // Invitation emails (Cloudflare Email Sending; notify.lume.software is the
  // onboarded sending domain). `pnpm dev` simulates it and only logs messages.
  // Sending to arbitrary recipients needs the Workers Paid plan.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["zora@notify.lume.software"]
    }
  ],
  // The design and photo engines (Zora Studio and Zora LightCraft, headless;
  // see AGENTS.md, "Design engine" and "Photo engine"). One Durable Object
  // class per engine container.
  "durable_objects": {
    "bindings": [
      { "name": "STUDIO_ENGINE", "class_name": "StudioEngine" },
      { "name": "LIGHTCRAFT_ENGINE", "class_name": "LightcraftEngine" }
    ]
  },
  "exports": {
    "StudioEngine": { "type": "durable-object", "storage": "sqlite" },
    "LightcraftEngine": { "type": "durable-object", "storage": "sqlite" }
  },
  // THE SWITCH for the engine containers: they stay off while this entry is
  // commented out (the tools then say the engine is not configured, unless
  // STUDIO_ENGINE_URL / LIGHTCRAFT_ENGINE_URL points at an engine). To switch
  // them on (Workers Paid plan), build the images from
  // ../zora-vector/apps/zora-studio-server/Dockerfile and
  // ../zora-lightcraft/apps/zora-lightcraft-server/Dockerfile, push them to
  // the Cloudflare registry and paste their digests, then uncomment:
  // "containers": [
  //   {
  //     "class_name": "StudioEngine",
  //     "scheduling_policy": "durable_object",
  //     "images": {
  //       "engine": {
  //         "image": "registry.cloudflare.com/bf552f67bcf46921dbe4137ee0ff8980/zora-studio-engine@sha256:<digest>"
  //       }
  //     }
  //   },
  //   {
  //     "class_name": "LightcraftEngine",
  //     "scheduling_policy": "durable_object",
  //     "images": {
  //       "engine": {
  //         "image": "registry.cloudflare.com/bf552f67bcf46921dbe4137ee0ff8980/zora-lightcraft-engine@sha256:<digest>"
  //       }
  //     }
  //   }
  // ],
  // Local dev cannot run containers on Windows (Wrangler refuses), and they
  // need Docker: `pnpm dev` never starts one. Use STUDIO_ENGINE_URL /
  // LIGHTCRAFT_ENGINE_URL instead.
  "dev": {
    "enable_containers": false
  },
  // Automated social publishing: dispatches due `scheduled` items and advances
  // asynchronous video uploads (Instagram Reels, TikTok, LinkedIn).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
  // Set as Worker secrets (`wrangler secret put <NAME>`), never committed:
  //   BETTER_AUTH_SECRET, BETTER_AUTH_URL, ALLOWED_SIGNUP_EMAILS,
  //   UNSPLASH_ACCESS_KEY, FAL_KEY, TREG_TOKEN
  // (the non-secret ones stay as secrets too so `wrangler deploy` never resets them).
}
