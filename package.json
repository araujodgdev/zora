{
  "name": "zora",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "deploy:ci": "wrangler d1 migrations apply zora --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:setup": "node scripts/setup-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply zora --local",
    "db:migrate:remote": "wrangler d1 migrations apply zora --remote",
    "studio:publish": "node scripts/studio-publish.ts",
    "lightcraft:publish": "node scripts/lightcraft-publish.ts",
    "fonts:sync": "node scripts/fonts-sync.ts",
    "auth:generate": "auth generate --config better-auth.config.ts --output src/db/auth-schema.ts --yes",
    "desktop:dev": "cargo run --manifest-path desktop/src-tauri/Cargo.toml -- --url http://localhost:3000",
    "desktop:build": "cargo build --release --manifest-path desktop/src-tauri/Cargo.toml",
    "desktop:check": "cargo check --manifest-path desktop/src-tauri/Cargo.toml",
    "desktop:package": "node scripts/desktop-package.ts",
    "desktop:package:debug": "node scripts/desktop-package.ts --debug --skip-editors"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@better-auth/mcp": "1.7.25",
    "@better-auth/oauth-provider": "1.7.25",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tauri-apps/api": "^2.12.5",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "lucide-react": "^1.73.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "auth": "1.7.25",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
