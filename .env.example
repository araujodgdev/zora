# Copy to .env with `pnpm env:setup` (generates BETTER_AUTH_SECRET for you).
# .env is git-ignored. In production these are Cloudflare Worker secrets/vars.

# Postgres connection string. Local default matches docker-compose.yml.
# Production: the Neon connection string (sslmode=require).
DATABASE_URL=postgres://zora:zora@127.0.0.1:5433/zora

# Database used by `pnpm test`. Never point this at real data: tests truncate tables.
TEST_DATABASE_URL=postgres://zora:zora@127.0.0.1:5433/zora_test

# Better Auth signing/encryption secret, at least 32 random characters.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public base URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails allowed to sign up (case-insensitive).
ALLOWED_SIGNUP_EMAILS=alice@example.com,bob@example.com
