# Copy to .env with `pnpm env:setup` (generates BETTER_AUTH_SECRET for you).
# .env is git-ignored. In production these are Cloudflare Worker secrets/vars.
# The database is a D1 binding (wrangler.jsonc), not a connection string, so
# there is no DATABASE_URL.

# Better Auth signing/encryption secret, at least 32 random characters.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public base URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails allowed to sign up (case-insensitive).
ALLOWED_SIGNUP_EMAILS=alice@example.com,bob@example.com

# Optional image providers for the MCP image tools (leave empty to disable).
# Unsplash access key (https://unsplash.com/oauth/applications): stock photos.
UNSPLASH_ACCESS_KEY=
# fal API key (https://fal.ai/dashboard/keys): generated images.
FAL_KEY=

# Optional design engine for the MCP design tools, reached over plain HTTP:
# the zora-studio-server binary run natively (see README, "Design engine").
# Empty: the STUDIO_ENGINE container (production) or "not configured".
STUDIO_ENGINE_URL=

# Optional social publishing via treg.to (https://treg.to/).
# Create a team API key (owner/admin role) in treg.to -> Team -> API Keys.
TREG_TOKEN=
# Optional override for treg base URL (defaults to https://treg.to).
TREG_BASE_URL=
